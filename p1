
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <fcntl.h>
#include <string.h>

int main()
{
    pid_t pid;
    int status;
    int fd;
    char buffer[100];
    char input[100];

    // PART 1: PROCESS MANAGEMENT

    printf("=== PROCESS MANAGEMENT ===\n");
    fflush(stdout);

    pid = fork();

    if (pid < 0)
    {
        perror("Fork failed");
        return 1;
    }
    else if (pid == 0)
    {
        // Child Process
        printf("\nChild Process:\n");
        printf("Child PID  : %d\n", getpid());
        printf("Parent PID : %d\n", getppid());
        fflush(stdout);

        // Replace child process with ls -l
        execl("/bin/ls", "ls", "-l", (char *)NULL);

        // Executes only if exec fails
        perror("Exec failed");
        _exit(1);
    }
    else
    {
        // Parent Process
        printf("\nParent Process:\n");
        printf("Parent PID : %d\n", getpid());
        printf("Child PID  : %d\n", pid);

        // Parent waits for child
        wait(&status);
        printf("\nChild process completed.\n");
    }

    // PART 2: FILE MANAGEMENT

    printf("\n=== FILE MANAGEMENT ===\n");

    fd = open("sample.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);

    if (fd < 0)
    {
        perror("File opening failed");
        return 1;
    }

    char message[] = "Hello! This is a file system call demonstration.\n";

    write(fd, message, strlen(message));

    lseek(fd, 0, SEEK_SET);

    int n = read(fd, buffer, sizeof(buffer) - 1);

    if (n < 0)
    {
        perror("File reading failed");
        close(fd);
        return 1;
    }

    buffer[n] = '\0';

    printf("File contents:\n%s", buffer);

    close(fd);

    // PART 3: INPUT / OUTPUT

    printf("\n=== INPUT / OUTPUT ===\n");

    printf("Enter a string: ");
    fflush(stdout);

    n = read(STDIN_FILENO, input, sizeof(input));

    if (n < 0)
    {
        perror("Input reading failed");
        return 1;
    }

    write(STDOUT_FILENO, "You entered: ", 13);
    write(STDOUT_FILENO, input, n);

    printf("\n");

    return 0;
}






