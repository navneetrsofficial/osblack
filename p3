# PRIORITY SCHEDULING

p = [["P1", 10, 3], ["P2", 1, 1], ["P3", 2, 4],
     ["P4", 1, 5], ["P5", 5, 2]]

p.sort(key=lambda x: x[2])
time, wt, tat, chart = 0, [], [], []

print("\nPRIORITY SCHEDULING")
print("Process", "BT", "Priority", "CT", "TAT", "WT", sep="\t")

for name, b, pr in p:
    w = time
    time += b
    t = time
    wt.append(w)
    tat.append(t)
    chart.append(name + "(" + str(w) + "-" + str(t) + ")")
    print(name, b, pr, t, t, w, sep="\t")

print("Average WT:", sum(wt)/5)
print("Average TAT:", sum(tat)/5)
print("Gantt Chart:", " | ".join(chart))
