p = ["P1", "P2", "P3", "P4", "P5"]
bt = [10, 1, 2, 1, 5]
pr = [3, 1, 4, 5, 2]
n = len(p)

order = sorted(range(n), key=lambda i: pr[i])

ct = [0] * n
gantt = []
time = 0

for i in order:
    start = time
    time += bt[i]
    ct[i] = time
    gantt.append((p[i], start, time))

tat = ct.copy()
wt = [tat[i] - bt[i] for i in range(n)]

print("PRIORITY SCHEDULING")
print("\nProcess\tBT\tPriority\tCT\tTAT\tWT")

for i in range(n):
    print(p[i], "\t", bt[i], "\t", pr[i], "\t\t",
          ct[i], "\t", tat[i], "\t", wt[i])

print("\nGantt Chart:")
for x in gantt:
    print("|", x[0], end=" ")
print("|")

print(gantt[0][1], end="")
for x in gantt:
    print("\t", x[2], end="")

print("\n\nAverage Waiting Time =", sum(wt) / n)
print("Average Turnaround Time =", sum(tat) / n)
