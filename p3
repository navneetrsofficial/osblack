
# ROUND ROBIN SCHEDULING

p = [["P1", 10], ["P2", 1], ["P3", 2], ["P4", 1], ["P5", 5]]
q = 3
bt = {x[0]: x[1] for x in p}
rem = bt.copy()
ct, chart, time = {}, [], 0

while any(rem.values()):
    for name in rem:
        if rem[name] > 0:
            t = min(q, rem[name])
            chart.append(name + "(" + str(time) + "-" + str(time+t) + ")")
            time += t
            rem[name] -= t
            if rem[name] == 0:
                ct[name] = time

print("\nROUND ROBIN")
print("Process", "BT", "CT", "TAT", "WT", sep="\t")
wt, tat = [], []

for name, b in bt.items():
    t = ct[name]
    w = t - b
    wt.append(w)
    tat.append(t)
    print(name, b, t, t, w, sep="\t")

print("Average WT:", sum(wt)/5)
print("Average TAT:", sum(tat)/5)
print("Gantt Chart:", " | ".join(chart))


