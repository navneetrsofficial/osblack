
a = [[0,1,0],[2,0,0],[3,0,2],[2,1,1],[0,0,2]]
m = [[7,5,3],[3,2,2],[9,0,2],[2,2,2],[4,3,3]]
v = [3,3,2]
n = [[m[i][j]-a[i][j] for j in range(3)] for i in range(5)]
print("Need Matrix:")
for r in n: print(r)
def check():
    f = [False]*5
    s = []
    w = v[:]
    for _ in range(5):
        for i in range(5):
            if not f[i] and all(n[i][j]<=w[j] for j in range(3)):
                for j in range(3): w[j] += a[i][j]
                f[i] = True
                s.append("P"+str(i))
    return s
s = check()
print("Safe Sequence:",s)
if len(s)==5: print("System is SAFE")
else: print("System is UNSAFE")
q = [1,0,2]
for j in range(3):
    v[j] -= q[j]
    a[1][j] += q[j]
    n[1][j] -= q[j]
s = check()
if len(s)==5: print("Request GRANTED")
else: print("Request DENIED")
