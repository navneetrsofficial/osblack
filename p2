
p = [
    ["P1", 0, 6],
    ["P2", 1, 8],
    ["P3", 2, 7],
    ["P4", 3, 3],
    ["P5", 4, 4]
]

p.sort(key=lambda x: x[1])

time = 0
total_wt = 0
total_tat = 0

print("p\tAT\tBT\tCT\tTAT\tWT")

gantt = "0"

for name, at, bt in p:

    if time < at:
        time = at

    ct = time + bt
    tat = ct - at
    wt = tat - bt

    print(name, at, bt, ct, tat, wt, sep="\t")

    total_wt += wt
    total_tat += tat

    time = ct
    gantt += " -- " + name + " -- " + str(ct)

print("\nAverage WT:", total_wt / 5)
print("Average TAT:", total_tat / 5)

print("\nGantt Chart:")
print(gantt)

#-----------------------------------------------


p = [
    ["P1", 0, 6],
    ["P2", 1, 8],
    ["P3", 2, 7],
    ["P4", 3, 3],
    ["P5", 4, 4]
]

time = 0
total_wt = 0
total_tat = 0
done = []
gantt = "0"

print("p\tAT\tBT\tCT\tTAT\tWT")

while len(done) < 5:

    ready = []

    for name, at, bt in p:
        if at <= time and name not in done:
            ready.append([name, at, bt])

    if len(ready) == 0:
        time += 1
        continue

    ready.sort(key=lambda x: x[2])

    name, at, bt = ready[0]

    time += bt

    ct = time
    tat = ct - at
    wt = tat - bt

    print(name, at, bt, ct, tat, wt, sep="\t")

    total_wt += wt
    total_tat += tat

    done.append(name)

    gantt += " -- " + name + " -- " + str(ct)

print("\nAverage WT:", total_wt / 5)
print("Average TAT:", total_tat / 5)

print("\nGantt Chart:")
print(gantt)
